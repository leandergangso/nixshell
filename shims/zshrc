# nixshell: run the real .zshrc, then prepend the dev PATH.
nixshell_dir=$ZDOTDIR
nixshell_real=${NIXSHELL_REAL_ZDOTDIR:-$HOME}
nixshell_path=${NIXSHELL_PATH-}
[ "$nixshell_real" = "$nixshell_dir" ] && nixshell_real=$HOME

# Source the real rc from the real ZDOTDIR.
if [ -n "$nixshell_real" ] && [ -f "$nixshell_real/.zshrc" ]; then
    ZDOTDIR=$nixshell_real
    export ZDOTDIR
    source "$ZDOTDIR/.zshrc"
    if [ -n "$ZDOTDIR" ] && [ "$ZDOTDIR" != "$nixshell_dir" ] && [ "$ZDOTDIR" != "$nixshell_real" ]; then
        nixshell_real=$ZDOTDIR
    fi
fi

export ZDOTDIR=$nixshell_real
[ -n "$nixshell_path" ] && export PATH="$nixshell_path:$PATH"
unset NIXSHELL_PATH NIXSHELL_REAL_ZDOTDIR nixshell_dir nixshell_real nixshell_path
